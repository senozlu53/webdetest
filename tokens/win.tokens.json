    "Document": { "$type": "typography", "$value": { "fontFamily": ["Times New Roman", "Times", "serif"], "fontSize": "1rem" }, "$description": "Belgeler ve web sayfaları" },
    "Fun": { "$type": "typography", "$value": { "fontFamily": ["Comic Sans MS", "cursive"], "fontSize": "1.5rem", "fontWeight": 700 }, "$description": "Kampanya ve pazarlama başlıkları" },
    "Pixel": { "$type": "typography", "$value": { "fontFamily": ["Pixelify Sans", "monospace"] }, "$description": "Kenar yumuşatmasız piksel yazı; ayarlardan bütün arayüz" },
    "Mono": { "$type": "typography", "$value": { "fontFamily": ["Courier New", "Courier", "monospace"], "fontSize": "0.8125rem" } }
  },
  "Size": {
    "ButtonHeight": { "$type": "dimension", "$value": "1.875rem" },
    "ButtonMinWidth": { "$type": "dimension", "$value": "5rem" },
    "TitleBar": { "$type": "dimension", "$value": "1.375rem" },
    "TitleButton": { "$type": "dimension", "$value": "1.125rem × 1rem" },
    "Taskbar": { "$type": "dimension", "$value": "2.75rem" },
    "IconSmall": { "$type": "dimension", "$value": "1rem", "$description": "16×16" },
    "IconLarge": { "$type": "dimension", "$value": "2rem", "$description": "32×32: aynı 16×16 çizim, 2 kat" }
  },
  "Scale": {
    "$description": "Madde 18: kök yazı boyu; bütün ölçüler rem olduğu için arayüz birlikte büyür",
    "Small": { "$type": "number", "$value": 1, "$description": "%100 (tarayıcı ayarı)" },
    "Large": { "$type": "number", "$value": 1.25 },
    "ExtraLarge": { "$type": "number", "$value": 1.5 }
  },
  "Texture": {
    "Dither": { "$type": "string", "$value": "2×2 dama: #008080 + #000080", "$description": "Madde 8: iki rengi serpiştirip üçüncüyü taklit etmek" },
    "Pattern": { "$type": "string", "$value": "8×8 1 bit tuğla, siyah" },
    "Wallpaper": { "$type": "string", "$value": "320×200, 16 renk, 4×4 Bayer sıralı dither, en yakın komşu büyütme" }
  },
  "Motion": {
    "$description": "Madde 16: animasyon yok",
    "Duration": { "$type": "duration", "$value": "0ms" },
    "Busy": { "$type": "string", "$value": "cursor: kum saati (16×16 piksel, 2 kat) yalnız yüklemede" },
    "Progress": { "$type": "string", "$value": "kesikli bloklar, ara kare yok" }
  },
  "Responsive": {
    "Breakpoint": { "$type": "dimension", "$value": "768px", "$description": "Madde 17: altında pencereler ve diyaloglar tam ekran (görev çubuğunun üstü), sürükleme yok, form aynı" }
  }
}
