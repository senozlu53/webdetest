{
  "$description": "Stil 020: 90s Old Web (Web 1.0). W3C DTCG formatı. Adlar Figma yolu ile aynıdır: Color/Win95Grey, Border/ClassicOutset, Border/ClassicInset. Gölge yok, yuvarlatma yok, animasyon yok; kabartma yalnız kenar rengiyle. Ölçüler rem (1rem = 16px, %100 ölçek). Gece varyantı Win95'in Yüksek Kontrast Siyah düzeni.",
  "Color": {
    "Win95Grey": { "$type": "color", "$value": "#C0C0C0", "dark": "#000000", "text": "#000000", "contrast": 11.54, "$description": "Madde 4: pencere yüzü, düğme, görev çubuğu" },
    "Navy": { "$type": "color", "$value": "#000080", "dark": "#800080", "text": "#FFFFFF", "contrast": 16.01, "$description": "Madde 4: etkin başlık çubuğu, seçim" },
    "Teal": { "$type": "color", "$value": "#008080", "dark": "#000000", "text": "#FFFFFF", "contrast": 4.77, "$description": "Madde 4: masaüstü" },
    "White": { "$type": "color", "$value": "#FFFFFF", "dark": "#000000", "text": "#000000", "contrast": 21, "$description": "Madde 4: belge alanı ve kabartmanın ışıklı kenarı" },
    "BevelShadow": { "$type": "color", "$value": "#808080", "$description": "Kabartmanın gölgeli kenarı, pasif başlık" },
    "BevelDark": { "$type": "color", "$value": "#000000", "dark": "#FFFFFF", "$description": "Varsayılan düğme çerçevesi, kaydırıcı tutamacı" },
    "InactiveTitle": { "$type": "color", "$value": "#808080", "text": "#C0C0C0", "dark": "#008080", "$description": "Pasif pencere başlığı (süs sayılır; etkin pencere hep lacivert)" },
    "Link": { "$type": "color", "$value": "#0000FF", "dark": "#FFFF00", "contrast": { "onGrey": 4.72, "onWhite": 8.59, "darkOnBlack": 19.56 } },
    "Visited": { "$type": "color", "$value": "#800080", "dark": "#00FF00", "contrast": { "onGrey": 5.17, "onWhite": 9.42, "darkOnBlack": 15.3 } },
    "VGA16": {
      "$description": "Madde 8 · 9: ikonlar ve duvar kağıtları yalnız bu 16 rengi kullanır",
      "Black": { "$type": "color", "$value": "#000000" },
      "White": { "$type": "color", "$value": "#FFFFFF" },
      "Silver": { "$type": "color", "$value": "#C0C0C0" },
      "Gray": { "$type": "color", "$value": "#808080" },
      "Navy": { "$type": "color", "$value": "#000080" },
      "Blue": { "$type": "color", "$value": "#0000FF" },
      "Teal": { "$type": "color", "$value": "#008080" },
      "Aqua": { "$type": "color", "$value": "#00FFFF" },
      "Yellow": { "$type": "color", "$value": "#FFFF00" },
      "Olive": { "$type": "color", "$value": "#808000" },
      "Red": { "$type": "color", "$value": "#FF0000" },
      "Maroon": { "$type": "color", "$value": "#800000" },
      "Green": { "$type": "color", "$value": "#008000" },
      "Lime": { "$type": "color", "$value": "#00FF00" },
      "Purple": { "$type": "color", "$value": "#800080" },
      "Fuchsia": { "$type": "color", "$value": "#FF00FF" }
    }
  },
  "Border": {
    "ClassicOutset": {
      "$type": "string",
      "$value": "2px solid; top #FFFFFF, left #FFFFFF, bottom #808080, right #808080",
      "figma": "Stroke · Inside · 2 · üst ve sol #FFFFFF; ayrı Stroke · Inside · 2 · alt ve sağ #808080 (Inner Shadow değil)",
      "css": ".outset { border: 2px solid; border-color: #FFF #808080 #808080 #FFF; }",
      "$description": "Madde 7 · 12: çıkıntı. Pencere, düğme, görev çubuğu"
    },
    "ClassicInset": {
      "$type": "string",
      "$value": "2px solid; top #808080, left #808080, bottom #FFFFFF, right #FFFFFF",
      "css": ".inset { border: 2px solid; border-color: #808080 #FFF #FFF #808080; }",
      "$description": "Çukur: metin alanı, liste, basılı düğme, saat"
    },
    "DefaultButton": { "$type": "string", "$value": "ClassicOutset + 1px dış #000000", "$description": "Enter'la seçilen varsayılan düğme" },
    "Focus": { "$type": "string", "$value": "0.0625rem dotted; düğmede 0.1875rem içeride", "$description": "Klasik noktalı odak dikdörtgeni" }
  },
  "Radius": {
