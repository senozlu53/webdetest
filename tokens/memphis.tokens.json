    "Button": { "$type": "shadow", "$value": { "color": "{Color.MemphisInk}", "offsetX": "5px", "offsetY": "5px", "blur": "0px", "spread": "0px" }, "pressed": "1px 1px + translate 4px 4px" }
  },
  "Pattern": {
    "Halftone": { "$type": "string", "$value": "radial-gradient(circle, #073B4C 2px, transparent 2.6px) 0 0 / 14px 14px", "mobile": "12px", "$description": "Madde 8 · 13: nokta vuruşlu zemin. Yazının arkasına girmez" },
    "Polka": { "$type": "string", "$value": "iki radial-gradient, 28px, 14px kaydırma" },
