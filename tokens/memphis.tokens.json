      "Pink": { "$type": "color", "$value": "#B3163F", "contrast": 6.77 },
      "Teal": { "$type": "color", "$value": "#03795A", "contrast": 5.4 },
      "Yellow": { "$type": "color", "$value": "#7A5200", "contrast": 6.92 }
    }
  },
  "Border": {
