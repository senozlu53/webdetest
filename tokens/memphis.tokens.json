    "MemphisInk": { "$type": "color", "$value": "#073B4C", "onWhite": 12.08, "$description": "Madde 4: 'Siyah'. Kontur, gölge ve bütün metin; Tailwind border-black" },
    "Paper": { "$type": "color", "$value": "#FFFFFF" },
