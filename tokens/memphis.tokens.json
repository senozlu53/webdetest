    "MemphisYellow": { "$type": "color", "$value": "#FFD166", "text": "#073B4C", "contrast": 8.38, "$description": "Madde 4: Hardal Sarısı. Ana dolgu, düğme, vurgu bloğu; Tailwind bg-yellow-400" },
    "MemphisTeal": { "$type": "color", "$value": "#06D6A0", "text": "#073B4C", "contrast": 6.4, "$description": "Madde 4: Cam Göbeği" },
