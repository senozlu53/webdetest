  "Typography": {
    "KineticDisplay": {
      "$type": "typography",
      "$description": "Madde 13: Typography/KineticDisplay. Dev başlık. Boy clamp() ile sınırlanır ve kapsayıcıya sığdırılır: min(clamp(…), 100cqw / (en uzun kelime × 1,25))",
      "$value": {
        "fontFamily": ["Syne Variable", "Syne", "Arial Black", "sans-serif"],
        "fontWeight": 800,
        "fontSize": "clamp(48px, 15vw, 260px)",
        "lineHeight": 0.88,
        "letterSpacing": "-0.045em"
      },
      "$extensions": {
        "com.devinim.text": {
          "textTransform": "uppercase"
        }
      }
    },
    "KineticHeading": {
      "$type": "typography",
      "$value": {
        "fontFamily": ["Syne Variable", "Syne", "Arial Black", "sans-serif"],
        "fontWeight": 800,
        "fontSize": "clamp(38px, 9.4vw, 152px)",
        "lineHeight": 0.88,
        "letterSpacing": "-0.045em"
      }
    },
    "Body": {
      "$type": "typography",
      "$value": {
        "fontFamily": ["Inter Variable", "Inter", "Helvetica Neue", "Arial", "sans-serif"],
        "fontWeight": 400,
        "fontSize": "17px",
        "lineHeight": 1.6,
        "letterSpacing": "0em"
      }
    },
    "Label": {
      "$type": "typography",
      "$value": {
        "fontFamily": ["Inter Variable", "Inter", "Helvetica Neue", "Arial", "sans-serif"],
        "fontWeight": 500,
        "fontSize": "12px",
        "lineHeight": 1.5,
        "letterSpacing": "0.18em"
      }
    },
    "WeightRange": {
      "$type": "string",
      "$value": "400 – 800",
      "$description": "Syne değişken eksen. Genişlik ağırlıkla artar: 700 → 800 arasında kelime yaklaşık 1,47 kat genişler; 400: 0,58 em/harf, 700: 0,75, 800: 1,14 (HAREKET kelimesi)"
    },
    "FitFactor": {
      "$type": "number",
      "$value": 1.25,
      "$description": "Syne 800 büyük harf ortalama ilerleme ≈ 1,0–1,17 em; sığdırma böleni 1,25 (dev kelime kapsayıcının ~%85–95’i)"
    }
  },
