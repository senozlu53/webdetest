  "Typography": {
    "VariableAxisWeight": {
      "$description": "Kalınlık (wght). Roboto Flex 100–1000; Recursive 300–1000; Fraunces 100–900",
      "min": {
        "$type": "number",
        "$value": 100
      },
      "default": {
        "$type": "number",
        "$value": 400
      },
      "max": {
        "$type": "number",
        "$value": 1000
      }
    },
    "VariableAxisWidth": {
      "$description": "Genişlik (wdth). Roboto Flex. Uzatılmış (151) ve sıkıştırılmış (25) radikal geometriler",
      "min": {
        "$type": "number",
        "$value": 25
      },
      "default": {
        "$type": "number",
        "$value": 100
      },
      "max": {
        "$type": "number",
        "$value": 151
      }
    },
    "VariableAxisSlant": {
