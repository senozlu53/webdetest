      },
      "default": {
        "$type": "number",
        "$value": 0
      },
      "max": {
        "$type": "number",
        "$value": 100
      }
    },
    "VariableAxisWonk": {
      "$description": "Tuhaflık (WONK). Fraunces",
      "min": {
        "$type": "number",
