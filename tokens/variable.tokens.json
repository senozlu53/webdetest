      },
      "default": {
        "$type": "number",
        "$value": 0
      },
      "max": {
        "$type": "number",
        "$value": 1
      }
    },
    "VariableDisplay": {
      "$type": "typography",
      "$description": "Madde 13: dev display başlık. Eksenler font-variation-settings ile sürülür; boy clamp() ile sınırlanır ve kapsayıcıya sığdırılır: min(clamp(…), 100cqw / (en uzun kelime × k))",
      "$value": {
        "fontFamily": ["Roboto Flex Variable", "Roboto Flex", "Arial Narrow", "Arial", "sans-serif"],
        "fontWeight": 400,
        "fontSize": "clamp(48px, 14vw, 220px)",
        "lineHeight": 0.95,
        "letterSpacing": "-0.02em"
      },
      "$extensions": {
        "com.devinim.variation": {
          "wght": "calc(400 + (var(--wght) - 400) * var(--e))",
          "wdth": "calc(100 + (var(--wdth) - 100) * var(--e))",
          "slnt": "calc(var(--slnt) * var(--e))"
        }
      }
    },
    "Body": {
      "$type": "typography",
      "$description": "Madde 18: gövde metni bükülmez. Inter, hiçbir eksen değişmez",
      "$value": {
        "fontFamily": ["Inter Variable", "Inter", "Helvetica Neue", "Arial", "sans-serif"],
        "fontWeight": 400,
        "fontSize": "17px",
        "lineHeight": 1.6,
        "letterSpacing": "0em"
      }
    },
    "Label": {
      "$type": "typography",
      "$value": {
        "fontFamily": ["Inter Variable", "Inter", "Helvetica Neue", "Arial", "sans-serif"],
        "fontWeight": 600,
        "fontSize": "12px",
        "lineHeight": 1.5,
        "letterSpacing": "0.16em"
      }
    },
    "Mono": {
      "$type": "typography",
      "$value": {
        "fontFamily": ["Recursive Variable", "Recursive", "ui-monospace", "Menlo", "monospace"],
        "fontWeight": 500,
        "fontSize": "13px",
        "lineHeight": 1.5,
        "letterSpacing": "0em"
      },
      "$extensions": {
        "com.devinim.variation": {
          "MONO": 1,
          "CASL": 0
        }
      }
    },
    "FitFactor": {
      "$type": "number",
      "$value": 0.66,
      "$description": "Harf başına ortalama ilerleme (em). Kaos halinde ortalama harf genişliği; sığdırma: 100cqw / (harf sayısı × 0,66)"
    },
    "ChaosChannels": {
      "$description": "Dinlenme halinde her harf üç normalize kanaldan (A kalınlık, B genişlik/yumuşaklık, C eğim/tuhaflık) kendi değerini alır; imleç etkisi bu kanalları yayla sürer",
      "flex": {
        "$type": "string",
        "$value": "wght 100–1000 · wdth 25–151 · slnt 0…−10"
      },
      "recursive": {
        "$type": "string",
        "$value": "wght 300–1000 · CASL 0–1 · slnt 0…−15"
      },
      "fraunces": {
        "$type": "string",
        "$value": "wght 100–900 · SOFT 0–100 · WONK 0/1"
      }
    }
  },
  "Motion": {
    "Spring": {
      "$description": "Madde 16: her harf ve her eksen kendi yayında. Yarı-örtük Euler. Sönüm oranı 1’in altında: hedef aşılır ve sallanır",
      "stiffness": {
        "$type": "number",
        "$value": 170
      },
      "damping": {
        "$type": "number",
        "$value": 11
      },
      "dampingRatio": {
        "$type": "number",
        "$value": 0.42,
        "$description": "ζ = c / (2 √k)"
      },
      "overshoot": {
        "$type": "number",
        "$value": 23.2,
        "$description": "Yüzde. Sayfada basamak yanıtı ölçülür: 23,1"
      }
    },
    "Proximity": {
      "swellRadius": {
        "$type": "dimension",
        "$value": "150px",
        "$description": "En az; harf yüksekliğinin 1,5 katı ile büyür"
      },
      "swellExponent": {
        "$type": "number",
        "$value": 1.4
      },
      "ringCenter": {
        "$type": "number",
        "$value": 0.42
      },
      "ringWidth": {
        "$type": "number",
        "$value": 0.16,
        "$description": "Halkadaki harf incelir (Gauss)"
      },
      "restSway": {
        "$type": "string",
        "$value": "± %10 (kalınlık), ± %8 (genişlik); sin(1,3 t + 0,9 i)"
      }
    },
    "HoverTransition": {
      "$description": "Kayıtlı --wght/--wdth/--slnt geçişi (@property sayesinde CSS ara değer üretir) ve doğrudan font-variation-settings geçişi",
      "museum": {
        "$type": "duration",
        "$value": "800ms",
        "$description": "Şekil müzesi kartları"
      },
      "direct": {
        "$type": "duration",
        "$value": "700ms",
        "$description": "font-variation-settings: doğrudan geçiş"
      },
      "proof": {
        "$type": "duration",
        "$value": "900ms",
        "$description": "@property kanıtı: kayıtlı ve kayıtsız özellik yan yana"
      },
      "glyph": {
        "$type": "duration",
        "$value": "300ms",
        "$description": "Simge (glif) üzerine gelince"
      }
    },
